# Normalize line endings so mixed Windows, macOS, and Linux contributors do not churn diffs.
* text=auto eol=lf

# Windows-native script hosts require CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF or they fail to execute.
*.sh text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.pfx binary
*.snk binary

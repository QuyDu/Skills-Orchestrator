# Normalize line endings so mixed Windows, macOS, and Linux teams do not churn diffs.
* text=auto eol=lf

# Windows-native script hosts require CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Shell scripts must keep LF or they fail to execute.
*.sh text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.dll binary
*.exe binary
*.pfx binary
*.snk binary

# Generated lock files are noisy in review but must stay diffable.
package-lock.json -diff

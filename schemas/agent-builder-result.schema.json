{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skills.dev/schemas/agent-builder-result/1.0.0",
  "title": "Agent Builder Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "completedAt", "status", "action", "targetPath", "blueprintSha256", "renderedSha256", "transactionId"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "completedAt": { "type": "string", "format": "date-time" },
    "status": { "const": "applied" },
    "action": { "enum": ["create", "update", "unchanged"] },
    "targetPath": { "type": "string", "pattern": "^\\.github/agents/[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.agent\\.md$" },
    "blueprintSha256": { "$ref": "#/$defs/sha256" },
    "renderedSha256": { "$ref": "#/$defs/sha256" },
    "transactionId": { "type": ["string", "null"], "pattern": "^AGT-[a-f0-9-]{36}$" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
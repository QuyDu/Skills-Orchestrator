{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/release-signature/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "signedArtifact", "publicKeyPem", "signature", "signedAt", "signer"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "algorithm": { "const": "RSA-SHA256" },
    "signedArtifact": { "const": "SHA256SUMS" },
    "publicKeyPem": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
    "signedAt": { "type": "string", "format": "date-time" },
    "signer": { "type": "string", "minLength": 1 }
  }
}

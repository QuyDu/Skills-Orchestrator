{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/gitleaks-scan/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "scanner", "configurationSha256", "allowlistCount", "repositoryRevision", "worktreeDigest", "scanInputDigest", "scopes", "commands", "status", "findings", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "releaseUrl", "platform", "archiveSha256", "checksumsSha256"],
      "properties": {
        "name": { "const": "gitleaks" },
        "version": { "const": "8.30.1" },
        "releaseUrl": { "const": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/" },
        "platform": { "enum": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64", "win32-arm64", "win32-x64"] },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "checksumsSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "configurationSha256": { "$ref": "#/$defs/sha256" },
    "allowlistCount": { "type": "integer", "minimum": 0 },
    "repositoryRevision": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
    "worktreeDigest": { "$ref": "#/$defs/sha256" },
    "scanInputDigest": { "$ref": "#/$defs/sha256" },
    "scopes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "enum": ["worktree", "staged", "untracked-distributable", "tracked-reports", "all-local-refs", "reachable-history"] }
    },
    "commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "command", "exitCode"],
        "properties": {
          "scope": { "enum": ["worktree", "staged", "history"] },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "const": 0 }
        }
      }
    },
    "status": { "enum": ["passed", "failed"] },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "staged", "history"],
      "properties": {
        "worktree": { "$ref": "#/$defs/findings" },
        "staged": { "$ref": "#/$defs/findings" },
        "history": { "$ref": "#/$defs/findings" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "findings": {
            "properties": {
              "worktree": { "maxItems": 0 },
              "staged": { "maxItems": 0 },
              "history": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "path", "commit", "startLine"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$" },
          "startLine": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
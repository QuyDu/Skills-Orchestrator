{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/security-check/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "scanner", "sourceDigest", "filesScanned", "dependencyCount", "status", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "filesScanned": { "type": "integer", "minimum": 0 },
    "dependencyCount": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["passed", "failed"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "severity", "path", "message"],
        "properties": {
          "ruleId": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "path": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}

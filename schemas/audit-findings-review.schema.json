{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skills.dev/schemas/audit-findings-review/1.0.0",
  "title": "Audit Findings Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "generatedAt", "sourceReport", "sourceAuditId", "summary", "findings", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewId": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceReport": { "type": "string" },
    "sourceAuditId": { "type": "string" },
    "summary": { "type": "object", "required": ["total", "confirmed", "needsMoreEvidence", "disputed", "falsePositive"], "properties": { "total": { "type": "integer", "minimum": 0 }, "confirmed": { "type": "integer", "minimum": 0 }, "needsMoreEvidence": { "type": "integer", "minimum": 0 }, "disputed": { "type": "integer", "minimum": 0 }, "falsePositive": { "type": "integer", "minimum": 0 } } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "status", "title", "category", "bugType", "securitySeverity", "confidence", "context", "riskExplanation", "rootCause", "resolution", "verification", "dependencies", "containment", "references", "decisionRationale"],
        "properties": {
          "findingId": { "type": "string", "pattern": "^AUD-[0-9]{4,}$" },
          "status": { "enum": ["confirmed", "needs-more-evidence", "disputed", "false-positive"] },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "bugType": { "type": "string" },
          "securitySeverity": { "enum": ["critical", "high", "medium", "low", "none"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "context": { "type": "string", "minLength": 1 },
          "riskExplanation": { "type": "string", "minLength": 1 },
          "rootCause": { "type": "string", "minLength": 1 },
          "resolution": { "type": "object", "required": ["recommended", "alternatives", "tradeoffs", "rollout", "rollback"], "properties": { "recommended": { "type": "string" }, "alternatives": { "type": "array", "items": { "type": "string" } }, "tradeoffs": { "type": "array", "items": { "type": "string" } }, "rollout": { "type": "string" }, "rollback": { "type": "string" } } },
          "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^AUD-[0-9]{4,}$" } },
          "containment": { "type": ["string", "null"] },
          "references": { "type": "array", "items": { "$ref": "code-audit-findings.schema.json#/$defs/reference" } },
          "decisionRationale": { "type": "string", "minLength": 1 },
          "severityChangeRationale": { "type": ["string", "null"] },
          "unresolvedQuestions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}

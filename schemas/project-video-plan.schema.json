{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.local/schemas/project-video-plan.schema.json",
  "title": "Project Video Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "project", "audience", "targetDurationSeconds", "video", "voice", "output", "scenes"],
  "properties": {
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "evidence"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "understanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "jsonSha256", "markdown", "markdownSha256", "repositoryDigestSha256", "generatedAt"],
      "properties": {
        "json": { "const": "reports/project-understanding.json" },
        "jsonSha256": { "$ref": "#/$defs/sha256" },
        "markdown": { "const": "reports/project-understanding.md" },
        "markdownSha256": { "$ref": "#/$defs/sha256" },
        "repositoryDigestSha256": { "$ref": "#/$defs/sha256" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "audience": { "type": "string", "minLength": 1, "maxLength": 300 },
    "targetDurationSeconds": { "type": "integer", "minimum": 60, "maximum": 600 },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_path",
        "script_provider",
        "narration_provider",
        "presenter_provider",
        "assembly_provider",
        "delivery_kind",
        "capabilities",
        "evidence",
        "approvals",
        "selection",
        "paths"
      ],
      "properties": {
        "production_path": { "enum": ["zero-install-preview", "narrated-mp4", "executive-demo"] },
        "script_provider": { "enum": ["agent-grounded", "azure-openai"] },
        "narration_provider": { "enum": ["browser-preview", "azure-neural", "local-piper"] },
        "presenter_provider": { "enum": ["none", "azure-speech-avatar"] },
        "assembly_provider": { "enum": ["browser-preview", "ffmpeg"] },
        "delivery_kind": { "enum": ["interactive-html", "portable-mp4"] },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claims_ledger", "script"],
          "properties": {
            "claims_ledger": { "$ref": "#/$defs/path" },
            "script": { "$ref": "#/$defs/path" },
            "project_understanding": { "$ref": "#/$defs/path" },
            "project_understanding_markdown": { "$ref": "#/$defs/path" }
          }
        },
        "approvals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "completed"],
          "properties": {
            "required": { "$ref": "#/$defs/approvalList" },
            "completed": { "$ref": "#/$defs/approvalList" }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["voice_profile", "avatar_profile"],
          "properties": {
            "voice_profile": { "type": ["string", "null"], "maxLength": 200 },
            "avatar_profile": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/avatarProfile" }
              ]
            }
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assets", "validation", "final_output"],
          "properties": {
            "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
            "validation": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
            "final_output": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/path" }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "presenter_provider": { "const": "azure-speech-avatar" } } },
          "then": { "properties": { "selection": { "properties": { "avatar_profile": { "$ref": "#/$defs/avatarProfile" } } } } },
          "else": { "properties": { "selection": { "properties": { "avatar_profile": { "type": "null" } } } } }
        }
      ]
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "backgroundColor", "primaryColor", "accentColor"],
      "properties": {
        "width": { "type": "integer", "enum": [854, 1280, 1920] },
        "height": { "type": "integer", "enum": [480, 720, 1080] },
        "fps": { "type": "integer", "enum": [24, 30] },
        "backgroundColor": { "$ref": "#/$defs/color" },
        "primaryColor": { "$ref": "#/$defs/color" },
        "accentColor": { "$ref": "#/$defs/color" }
      },
      "allOf": [
        { "if": { "properties": { "width": { "const": 854 } } }, "then": { "properties": { "height": { "const": 480 } } } },
        { "if": { "properties": { "width": { "const": 1280 } } }, "then": { "properties": { "height": { "const": 720 } } } },
        { "if": { "properties": { "width": { "const": 1920 } } }, "then": { "properties": { "height": { "const": 1080 } } } }
      ]
    },
    "voice": {
      "oneOf": [
        { "$ref": "#/$defs/azureVoice" },
        { "$ref": "#/$defs/localVoice" },
        { "$ref": "#/$defs/browserVoice" }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "pattern": "^dist/project-video/[a-z0-9-]+\\.(?:mp4|html)$" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "subtitle", "narration", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "subtitle": { "type": "string", "minLength": 1, "maxLength": 180 },
          "narration": { "type": "string", "minLength": 20, "maxLength": 1600 },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "1.2.0" } }, "required": ["schemaVersion"] },
      "then": {
        "required": ["understanding", "production"],
        "properties": {
          "production": {
            "properties": {
              "evidence": { "required": ["project_understanding", "project_understanding_markdown"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["production"],
        "properties": {
          "production": {
            "properties": { "delivery_kind": { "const": "interactive-html" } },
            "required": ["delivery_kind"]
          }
        }
      },
      "then": { "properties": { "output": { "properties": { "file": { "pattern": "^dist/project-video/[a-z0-9-]+\\.html$" } } } } }
    },
    {
      "if": {
        "required": ["production"],
        "properties": {
          "production": {
            "properties": { "delivery_kind": { "const": "portable-mp4" } },
            "required": ["delivery_kind"]
          }
        }
      },
      "then": { "properties": { "output": { "properties": { "file": { "pattern": "^dist/project-video/[a-z0-9-]+\\.mp4$" } } } } }
    },
    {
      "if": {
        "not": { "required": ["production"] },
        "properties": {
          "voice": {
            "properties": { "provider": { "const": "browser-preview" } },
            "required": ["provider"]
          }
        }
      },
      "then": { "properties": { "output": { "properties": { "file": { "pattern": "^dist/project-video/[a-z0-9-]+\\.html$" } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "approvalList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "status", "region", "evidence"],
      "properties": {
        "capability": { "enum": ["azure-openai", "azure-neural", "azure-speech-avatar"] },
        "status": { "enum": ["ready", "unavailable", "unknown"] },
        "region": { "type": ["string", "null"], "maxLength": 100 },
        "resource_id": { "type": ["string", "null"], "maxLength": 500 },
        "deployment_id": { "type": ["string", "null"], "maxLength": 300 },
        "model_id": { "type": ["string", "null"], "maxLength": 300 },
        "evidence": { "$ref": "#/$defs/path" }
      }
    },
    "avatarProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "voice", "language", "layout", "background", "segments", "generation_status", "assets"],
      "properties": {
        "character": { "type": "string", "minLength": 1, "maxLength": 200 },
        "voice": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "layout": { "enum": ["picture-in-picture", "full-frame"] },
        "background": { "type": "string", "minLength": 1, "maxLength": 200 },
        "segments": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^scene-[0-9]{2}$" } },
        "generation_status": { "enum": ["planned", "approved", "generated", "validated"] },
        "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "azureVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "locale", "style", "styleDegree", "ratePercent", "sentencePauseMs"],
      "properties": {
        "provider": { "const": "azure-neural" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9-]+(?::[A-Za-z0-9-]+)?Neural$" },
        "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "style": { "type": "string", "pattern": "^(auto|[a-z][a-z0-9-]{0,39})$" },
        "styleDegree": { "type": "number", "minimum": 0.01, "maximum": 2 },
        "ratePercent": { "type": "integer", "minimum": -20, "maximum": 20 },
        "sentencePauseMs": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "localVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "locale", "lengthScale", "sentenceSilenceSeconds"],
      "properties": {
        "provider": { "const": "local-piper" },
        "name": { "const": "en_US-ljspeech-high" },
        "locale": { "const": "en-US" },
        "lengthScale": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "sentenceSilenceSeconds": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "browserVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "locale"],
      "properties": {
        "provider": { "const": "browser-preview" },
        "name": { "const": "default-English" },
        "locale": { "const": "en-US" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      }
    }
  }
}
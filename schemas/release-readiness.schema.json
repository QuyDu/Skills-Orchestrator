{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/release-readiness/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "version", "evaluatedAt", "commit", "candidateSha256", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "candidateSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["blocked", "production-ready"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "blocking", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "blocked"] },
          "blocking": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}

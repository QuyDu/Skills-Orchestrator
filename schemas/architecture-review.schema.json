{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/architecture-review/1.0.0",
  "title": "Architecture Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewId", "generatedAt", "scope", "coverage", "findings", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewId": { "type": "string", "pattern": "^ARC-[0-9]{4,}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "environments", "targetCloud", "excluded"],
      "properties": {
        "components": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "environments": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "targetCloud": { "enum": ["azure-commercial", "azure-government", "other", "unknown"] },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pillar", "assessed", "evidence"],
        "properties": {
          "pillar": { "enum": ["reliability", "security", "cost-optimization", "operational-excellence", "performance-efficiency"] },
          "assessed": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "pillar", "location", "impact", "severity", "confidence", "recommendation", "tradeOffs", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^ARCF-[0-9]{4,}$" },
          "title": { "type": "string", "minLength": 1 },
          "pillar": { "enum": ["reliability", "security", "cost-optimization", "operational-excellence", "performance-efficiency"] },
          "location": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "recommendation": { "type": "string", "minLength": 1 },
          "tradeOffs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "decisionRecord": { "type": ["string", "null"] },
          "conflictsWithDecision": { "type": "boolean" },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-skills.dev/schemas/project-installation-verification/1.0.0",
  "title": "Project Installation Verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verifiedAt", "frameworkVersion", "runtimeVersion", "profile", "mode", "status", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "frameworkVersion": { "type": "string", "minLength": 1 },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "profile": { "enum": ["core", "durable", "distributed", "advanced"] },
    "mode": { "enum": ["new-project-creation", "existing-project-adoption"] },
    "status": { "const": "passed" },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameworkSkills", "schemas", "profilesCurrent", "inventoryCurrent", "manifestCurrent", "orchestratorConfigured", "clarificationConfigured", "clarificationProtocolPresent", "customizationAssetsPresent", "copilotRouted", "agentInstructionsRouted", "workspaceSupportPresent", "legacySkillsRemoved"],
      "properties": {
        "frameworkSkills": { "type": "integer", "minimum": 1 },
        "schemas": { "type": "integer", "minimum": 1 },
        "profilesCurrent": { "const": true },
        "inventoryCurrent": { "const": true },
        "manifestCurrent": { "const": true },
        "orchestratorConfigured": { "const": true },
        "clarificationConfigured": { "const": true },
        "clarificationProtocolPresent": { "const": true },
        "customizationAssetsPresent": { "const": true },
        "copilotRouted": { "const": true },
        "agentInstructionsRouted": { "const": true },
        "workspaceSupportPresent": { "const": true },
        "legacySkillsRemoved": { "const": true }
      }
    }
  }
}
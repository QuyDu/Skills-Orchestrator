{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/project-guide/1.0.0",
  "title": "Project Guide",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "projectUnderstanding", "guide", "claims"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projectUnderstanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "jsonSha256", "markdown", "markdownSha256"],
      "properties": {
        "json": { "const": "reports/project-understanding.json" },
        "jsonSha256": { "$ref": "#/$defs/sha256" },
        "markdown": { "const": "reports/project-understanding.md" },
        "markdownSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "guide": { "const": "docs/PROJECT-GUIDE.md" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "topic", "status", "statement", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^claim-[a-z0-9-]+$" },
          "topic": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "planned", "unavailable"] },
          "statement": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

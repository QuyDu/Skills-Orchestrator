{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills-orchestrator.dev/schemas/release-operations/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "candidateSha256", "owners", "signals", "revocation"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "candidateSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "securityResponse", "artifactRevocation"],
      "properties": {
        "release": { "$ref": "#/$defs/owner" },
        "securityResponse": { "$ref": "#/$defs/owner" },
        "artifactRevocation": { "$ref": "#/$defs/owner" }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "checkedAt", "evidence"],
        "properties": {
          "id": { "enum": ["github-security-validation", "github-codeql", "github-secret-scanning", "github-dependabot-alerts", "private-vulnerability-reports", "internal-artifact-install-health", "artifact-revocation-status"] },
          "status": { "enum": ["passing", "blocked", "failing"] },
          "checkedAt": { "type": ["string", "null"], "format": "date-time" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "owner", "testedAt", "evidence"],
      "properties": {
        "status": { "enum": ["ready", "not-configured", "failed"] },
        "owner": { "$ref": "#/$defs/owner" },
        "testedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "owner": { "type": ["string", "null"], "pattern": "^@[A-Za-z0-9](?:[A-Za-z0-9-]{0,37})$" }
  }
}
{
  "schemaVersion": "1.0.0",
  "product": "project-skills-orchestrator",
  "distribution": "private-internal-package",
  "publicDistributionAllowed": false,
  "requiredArtifacts": [
    "standalone",
    "checksums",
    "private-package",
    "sbom",
    "provenance"
  ],
  "requireSignature": true,
  "requireIndependentReview": true,
  "requiredPlatforms": [
    "windows",
    "linux",
    "macos"
  ],
  "requiredNodeMajors": [
    22,
    24,
    26
  ],
  "requiredOperationalRoles": [
    "release",
    "securityResponse",
    "artifactRevocation"
  ],
  "monitoringSignals": [
    "github-security-validation",
    "github-codeql",
    "github-secret-scanning",
    "github-dependabot-alerts",
    "private-vulnerability-reports",
    "internal-artifact-install-health",
    "artifact-revocation-status"
  ],
  "releaseStatus": "blocked",
  "blockers": [
    "trusted-signature",
    "independent-review",
    "operational-readiness"
  ]
}
